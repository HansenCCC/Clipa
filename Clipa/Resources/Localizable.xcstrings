    "Everything you copy is saved here. Press ⌘⇧V anywhere to open your clipboard history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما تنسخه يُحفَظ هنا. اضغط ⌘⇧V في أي مكان لفتح سجلّ الحافظة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything you copy is saved here. Press ⌘⇧V anywhere to open your clipboard history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que copias se guarda aquí. Pulsa ⌘⇧V en cualquier lugar para abrir el historial del portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que vous copiez est enregistré ici. Appuyez sur ⌘⇧V partout pour ouvrir votre historique du presse-papiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしたものはすべてここに保存されます。どこでも ⌘⇧V を押すとクリップボード履歴が開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사한 모든 항목이 여기에 저장됩니다. 어디서든 ⌘⇧V를 눌러 클립보드 기록을 여세요."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que copia fica guardado aqui. Prima ⌘⇧V em qualquer lugar para abrir o histórico da área de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что вы копируете, сохраняется здесь. Нажмите ⌘⇧V где угодно, чтобы открыть историю буфера обмена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopyaladığınız her şey burada saklanır. Pano geçmişinizi açmak için herhangi bir yerde ⌘⇧V tuşlarına basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你复制的一切都会保存在这里。在任意位置按 ⌘⇧V 打开剪贴板历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你複製的一切都會儲存在這裡。在任何地方按 ⌘⇧V 即可打開剪貼簿記錄。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你複製的一切都會儲存在這裡。在任何位置按 ⌘⇧V 即可開啟剪貼簿記錄。"
          }
        }
      }
    },
