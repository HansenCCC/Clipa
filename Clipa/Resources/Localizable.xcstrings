    "AES-256. Password-protected zips open in Keka, 7-Zip or WinRAR — the macOS Archive Utility can't open them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256. تُفتح ملفات zip المحمية بكلمة سر عبر Keka أو 7-Zip أو WinRAR — أداة الأرشفة في macOS لا يمكنها فتحها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256. Password-protected zips open in Keka, 7-Zip or WinRAR — the macOS Archive Utility can't open them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256. Los ZIP protegidos con contraseña se abren en Keka, 7-Zip o WinRAR; la Utilidad de Archivo de macOS no puede abrirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256. Les zips protégés par mot de passe s’ouvrent avec Keka, 7-Zip ou WinRAR — l’Utilitaire d’archive de macOS ne peut pas les ouvrir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256。パスワード付き zip は Keka、7-Zip、WinRAR で開けます。macOS のアーカイブユーティリティでは開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256. 암호로 보호된 zip은 Keka, 7-Zip 또는 WinRAR에서 열 수 있으며, macOS 아카이브 유틸리티로는 열 수 없습니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256. Os zips protegidos por palavra-passe abrem no Keka, 7-Zip ou WinRAR — o Utilitário de Arquivo do macOS não os consegue abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256. Zip-архивы с паролем открываются в Keka, 7-Zip или WinRAR — стандартная Утилита архивирования macOS их не откроет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256. Parola korumalı zip dosyaları Keka, 7-Zip veya WinRAR ile açılır — macOS Arşiv Aracı bunları açamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256。加密 zip 需用 Keka、7-Zip 或 WinRAR 打开——macOS 自带归档工具打不开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256。加密的 zip 需用 Keka、7-Zip 或 WinRAR 開啟——macOS 內建的封存工具程式無法開啟。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AES-256。有密碼保護的 zip 需用 Keka、7-Zip 或 WinRAR 開啟——macOS 內置的封存工具程式無法開啟。"
          }
        }
      }
    },
