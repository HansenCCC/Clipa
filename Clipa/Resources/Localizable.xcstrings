          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las compras dentro de la app no están disponibles ahora mismo. Inténtalo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats intégrés sont indisponibles pour le moment. Veuillez réessayer plus tard."
