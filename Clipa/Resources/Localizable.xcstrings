    "In-app purchases are unavailable right now. Please try again later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمليات الشراء داخل التطبيق غير متاحة حاليًا. يُرجى المحاولة لاحقًا."
          }
        },
        "en" : {
