    "Accessibility not granted — auto-paste falls back to manual ⌘V." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُمنح إذن تعذُّر الوصول — يتحوّل اللصق التلقائي إلى اللصق اليدوي ⌘V."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility not granted — auto-paste falls back to manual ⌘V."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesibilidad no concedida: el pegado automático pasa a ⌘V manual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibilité non accordée — le collage automatique bascule sur ⌘V manuel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティが許可されていません。自動ペーストは手動の ⌘V に切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 권한이 없어 자동 붙여넣기가 수동 ⌘V로 대체됩니다."
